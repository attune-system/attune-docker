# Generated by ./scripts/create-env.sh. Do not commit the resulting .env file.
ATTUNE_IMAGE_REGISTRY=ghcr.io/attune-system
# `edge` is the newest published tag while no `latest` tag is available.
ATTUNE_IMAGE_TAG=edge

JWT_SECRET=
ENCRYPTION_KEY=

# Required by the API so agents can bootstrap their binary distribution.
AGENT_BOOTSTRAP_TOKEN=

ATTUNE_TEST_LOGIN=test@attune.local
ATTUNE_TEST_PASSWORD=TestPass123!
ATTUNE_TEST_DISPLAY_NAME=Test User

# Browser-visible endpoints. Change these when publishing the web UI behind a proxy.
API_URL=http://localhost:8080
WS_URL=ws://localhost:8081
